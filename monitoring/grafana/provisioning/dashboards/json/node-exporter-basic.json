{
  "id": null,
  "uid": "node-exporter-basic",
  "title": "VMs — USE (CPU / Mem / Disk)",
  "tags": ["infra", "node", "use"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(node_cpu_seconds_total{job=\"node-vms\"}, env)", "refId": "Env" },
        "definition": "label_values(node_cpu_seconds_total{job=\"node-vms\"}, env)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU utilisé %",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (env) (rate(node_cpu_seconds_total{job=\"node-vms\",env=~\"$env\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mémoire disponible ratio",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"node-vms\",env=~\"$env\"} / node_memory_MemTotal_bytes{job=\"node-vms\",env=~\"$env\"}",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disque / disponible",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"node-vms\",env=~\"$env\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node-vms\",env=~\"$env\",mountpoint=\"/\"}",
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    }
  ]
}
